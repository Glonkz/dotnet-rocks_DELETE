@page
@model ProcsOtherModel
@{
    ViewData["Title"] = "Processes";
}
<h1>@ViewData["Title"]</h1>

@foreach (var Proc in (System.Diagnostics.Process[])ViewData["procs"]!)
{
    <div>
        <b>@Proc.ProcessName</b> - ID: <a asp-page="/ProcOtherDetails" asp-route-id="@Proc.Id">@Proc.Id</a>
    </div>
}
