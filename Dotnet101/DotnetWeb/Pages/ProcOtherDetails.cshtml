@page "{id:int?}"
@model DotnetWeb.Pages.ProcOtherDetailsModel
@{
    ViewData["Title"] = "Process Details";
}

@if (Model.Proc != null)
{
    <h2>@Model.Proc.ProcessName</h2>
    <p>ID: @Model.Proc.Id</p>
    <p>Memory: @Model.Proc.WorkingSet64 bytes</p>
}
else
{
    <p>Process not found or already exited.</p>
}